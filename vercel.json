{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/styles.css", "destination": "/dashboard/styles.css" },
    { "source": "/app.js", "destination": "/dashboard/app.js" },
    { "source": "/enhance.js", "destination": "/dashboard/enhance.js" },
    { "source": "/", "destination": "/dashboard/index.html" },
    { "source": "/((?!api|dashboard).*)", "destination": "/dashboard/$1" }
  ]
}
